# Ghibli Tracker: variaveis de ambiente (todas opcionais, com valores padrao)
# Copie para .env (ignorado pelo Git):  cp .env.example .env
# Carregue com (Node 18.17+ ou 20.6+):  node --env-file=.env src/server.js
# Nunca versione o arquivo .env nem coloque segredos neste exemplo.

# Porta do servidor HTTP
PORT=3000

# URL base da API publica do Studio Ghibli
GHIBLI_API_URL=https://ghibliapi.vercel.app/films

# Caminho do arquivo JSON onde a watchlist e persistida
DATA_FILE=data/watchlist.json